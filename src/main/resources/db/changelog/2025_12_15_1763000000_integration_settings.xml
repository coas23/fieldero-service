<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1763000000-1" author="codex">
        <createTable tableName="integration_settings">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="lexware_secret_encrypted" type="text"/>
            <column name="company_settings_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="integration_settings"
                baseColumnNames="company_settings_id"
                referencedTableName="company_settings"
                referencedColumnNames="id"
                constraintName="fk_integration_settings_company_settings"/>

        <addUniqueConstraint tableName="integration_settings"
                             columnNames="company_settings_id"
                             constraintName="uc_integration_settings_company_settings"/>
    </changeSet>
    <changeSet id="1763000000-2" author="codex" context="dev,prod,test">
        <sql>
            INSERT INTO integration_settings (company_settings_id)
            SELECT id FROM company_settings
            WHERE id NOT IN (SELECT company_settings_id FROM integration_settings);
        </sql>
    </changeSet>
</databaseChangeLog>
